# ChargeMap PRODUCTION env — copy to `.env.production` on the droplet and fill in.
# `.env.production` is gitignored (matched by *.production via .gitignore rule below).
# NEVER commit real secrets.

# --- MongoDB (Atlas recommended) ---
# Atlas: Connect > Drivers. Insert the db name "chargemap" before the "?" and keep retryWrites.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chargemap?retryWrites=true&w=majority&appName=ChargeMap
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chargemap?retryWrites=true&w=majority&appName=ChargeMap

# --- JWT signing secret (Base64, 32+ bytes). Generate: openssl rand -base64 48 ---
JWT_SECRET=change-me-generate-a-strong-base64-secret
JWT_EXPIRY_MINUTES=1440

# --- AES-256 key for encrypting OAuth tokens / VIN (Base64, exactly 32 bytes) ---
# Generate: openssl rand -base64 32
CHARGEMAP_CRYPTO_KEY=change-me-base64-32-bytes

# --- Initial super admin (created once on first startup; the ONLY seeded account) ---
# Stations, rewards, and other users start empty in production.
CHARGEMAP_SUPERADMIN_EMAIL=superadmin@yourdomain.com
CHARGEMAP_SUPERADMIN_PASSWORD=change-me-strong-password
# Optional display name (defaults to "Super Admin")
# CHARGEMAP_SUPERADMIN_NAME=Super Admin

# --- Frontend build-time (Mapbox token; inlined into the SPA at build) ---
# Also export this in the shell before `docker compose build` so the build arg is picked up.
VITE_MAPBOX_TOKEN=pk.your_mapbox_token

# NOTE: SPRING_PROFILES_ACTIVE=prod, REDIS_HOST=redis, REDIS_PORT=6379, SERVER_PORT=8080
# are set in docker-compose.prod.yml and don't need to be here.
