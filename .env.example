# ChargeMap environment template — copy to `.env` and fill in real values.
# `.env` is gitignored; this template is safe to commit (no secrets).

# MongoDB Atlas connection string. Get it from Atlas > Connect > Drivers.
# Insert the database name ("chargemap") before the "?" and keep retryWrites for transactions.
# Example:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chargemap?retryWrites=true&w=majority&appName=ChargeMap
MONGODB_URI=mongodb://localhost:27017/chargemap

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT signing secret (Base64). Generate: openssl rand -base64 48
JWT_SECRET=change-me-generate-a-strong-base64-secret
JWT_EXPIRY_MINUTES=1440

SERVER_PORT=8080
